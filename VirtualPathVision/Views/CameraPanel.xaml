<UserControl x:Class="VirtualPathVision.Views.CameraPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════
             CARD 1 — Connection & Source
             ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Style="{StaticResource GlassCard}" Padding="24" Margin="0,0,0,16">
            <StackPanel>

                <!-- Header -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="SectionTitleText"
                                   Text="Camera"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <Border Margin="14,0,0,0" Padding="10,4" CornerRadius="14"
                                Background="{DynamicResource PrimaryDimBrush}"
                                BorderBrush="{DynamicResource GlassBorderBrush}"
                                BorderThickness="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="ConnectionDot"
                                         Width="8" Height="8"
                                         Fill="{DynamicResource DangerBrush}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,7,0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#FF453A"
                                                          ShadowDepth="0"
                                                          BlurRadius="8"
                                                          Opacity="0.6" />
                                    </Ellipse.Effect>
                                </Ellipse>
                                <TextBlock x:Name="ConnectionStatusText"
                                           Text="Disconnected"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 双视图开关（默认关闭：仅显示单屏） -->
                    <ToggleButton x:Name="DualViewToggle"
                                  Grid.Column="1"
                                  Style="{StaticResource GlassToggleButton}"
                                  ToolTip="第二视图 / Dual View"
                                  Click="DualViewToggle_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7C4;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" VerticalAlignment="Center" />
                            <TextBlock x:Name="DualViewLabelText" Text="双视图" FontSize="12"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                </Grid>

                <!-- Source row -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="230" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="SourceLabel"
                               Grid.Column="0"
                               Text="Source:"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />

                    <ComboBox x:Name="SourceTypeComboBox"
                              Grid.Column="1"
                              Style="{StaticResource GlassComboBox}"
                              SelectedIndex="0"
                              SelectionChanged="SourceTypeComboBox_SelectionChanged">
                        <ComboBoxItem Content="Local Camera"
                                      Style="{StaticResource GlassComboBoxItem}"
                                      IsSelected="True" />
                        <ComboBoxItem Content="Network Stream"
                                      Style="{StaticResource GlassComboBoxItem}" />
                        <ComboBoxItem Content="File Replay"
                                      Style="{StaticResource GlassComboBoxItem}" />
                    </ComboBox>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="ConnectButton"
                                Content="Connect"
                                Style="{StaticResource AccentButton}"
                                Click="ConnectButton_Click"
                                Margin="0,0,10,0" />
                        <Button x:Name="DisconnectButton"
                                Content="Disconnect"
                                Style="{StaticResource DangerButton}"
                                IsEnabled="False"
                                Click="DisconnectButton_Click"
                                Margin="0,0,10,0" />
                        <Button x:Name="LoadImageButton"
                                Content="Load Image"
                                Style="{StaticResource GlassButton}"
                                Click="LoadImageButton_Click" />
                    </StackPanel>
                </Grid>

                <!-- Replay config (collapsible) -->
                <Border x:Name="ReplayConfigPanel"
                        Visibility="Collapsed"
                        Background="{DynamicResource InsetBrush}"
                        CornerRadius="{StaticResource CornerSm}"
                        Padding="14"
                        BorderBrush="{DynamicResource GlassBorderBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="ReplayFileLabel" Text="Video:"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <TextBox x:Name="ReplayPathTextBox"
                                     Grid.Column="1"
                                     Text=""
                                     Style="{StaticResource GlassTextBox}"
                                     VerticalContentAlignment="Center"
                                     Margin="0,0,8,0" />
                            <Button x:Name="BrowseReplayButton"
                                    Grid.Column="2"
                                    Content="Browse..."
                                    Style="{StaticResource GlassButton}"
                                    Click="BrowseReplayButton_Click" />
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="ReplayFpsLabel" Text="FPS:"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <TextBox x:Name="ReplayFpsTextBox"
                                     Grid.Column="1"
                                     Text="25"
                                     Style="{StaticResource GlassTextBox}"
                                     Width="60"
                                     VerticalContentAlignment="Center"
                                     Margin="0,0,16,0"
                                     TextChanged="ReplayConfig_Changed" />

                            <TextBlock x:Name="ReplayLoopLabel" Grid.Column="2"
                                       Text="Loop:"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <CheckBox x:Name="ReplayLoopCheckBox"
                                      Grid.Column="3"
                                      IsChecked="True"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Left"
                                      Margin="0,0,16,0"
                                      Checked="ReplayConfig_Changed"
                                      Unchecked="ReplayConfig_Changed" />

                            <TextBlock x:Name="ReplayProgressLabel" Grid.Column="4"
                                       Text="0 / 0"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <ProgressBar x:Name="ReplayProgressBar"
                                         Grid.Column="5"
                                         Width="130"
                                         Height="6"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="0"
                                         VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Network config (collapsible) -->
                <Border x:Name="NetworkConfigPanel"
                        Visibility="Collapsed"
                        Background="{DynamicResource InsetBrush}"
                        CornerRadius="{StaticResource CornerSm}"
                        Padding="14"
                        BorderBrush="{DynamicResource GlassBorderBrush}"
                        BorderThickness="1"
                        Margin="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="CameraIpLabel" Text="IP:"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBox x:Name="IPTextBox"
                                 Text="127.0.0.1"
                                 Style="{StaticResource GlassTextBox}"
                                 Width="170"
                                 VerticalContentAlignment="Center" />
                        <TextBlock Text=":"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="8,0" />
                        <TextBox x:Name="PortTextBox"
                                 Text="8080"
                                 Style="{StaticResource GlassTextBox}"
                                 Width="90"
                                 VerticalContentAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════
             CARD 2 — Preview (fills remaining space) + Controls
             ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Preview area: bounded by the * row, image scales to fit -->
                <Grid Grid.Row="0" MinHeight="200">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="SecondViewColumn" Width="0" />
                    </Grid.ColumnDefinitions>

                    <!-- Primary view -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource InputBgBrush}"
                            BorderBrush="{DynamicResource GlassBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CornerMd}"
                            ClipToBounds="True">
                        <Grid>
                            <Image x:Name="OriginalImage"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <StackPanel x:Name="EmptyOverlayLeft"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="&#x1F4F7;"
                                           FontSize="34"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Center"
                                           Opacity="0.35" />
                                <TextBlock x:Name="NoSignalOriginalText" Text="No Signal"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Secondary view (hidden until enabled) -->
                    <Border x:Name="SecondViewBorder"
                            Grid.Column="1"
                            Visibility="Collapsed"
                            Background="{DynamicResource InputBgBrush}"
                            BorderBrush="{DynamicResource GlassBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CornerMd}"
                            Margin="14,0,0,0"
                            ClipToBounds="True">
                        <Grid>
                            <Image x:Name="EdgeImage"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <StackPanel x:Name="EmptyOverlayRight"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="&#x2699;"
                                           FontSize="34"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Center"
                                           Opacity="0.35" />
                                <TextBlock x:Name="NoSignalEdgeText" Text="No Signal"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Bottom toolbar: controls (left) + stats (right) -->
                <Grid Grid.Row="1" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button x:Name="StartCameraButton"
                                Content="Start Camera"
                                Style="{StaticResource AccentButton}"
                                Click="StartCameraButton_Click"
                                Margin="0,0,10,0" />
                        <Button x:Name="StopCameraButton"
                                Content="Stop Camera"
                                Style="{StaticResource DangerButton}"
                                IsEnabled="False"
                                Click="StopCameraButton_Click"
                                Margin="0,0,10,0" />
                        <Button x:Name="SaveScreenshotButton"
                                Content="Screenshot"
                                Style="{StaticResource GlassButton}"
                                Click="SaveScreenshotButton_Click"
                                Margin="0,0,10,0" />
                        <Button x:Name="RecordButton"
                                Content="Record"
                                Style="{StaticResource GlassButton}"
                                Click="RecordButton_Click" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource PrimaryDimBrush}"
                                CornerRadius="{StaticResource CornerSm}"
                                Padding="12,5" Margin="0,0,8,0"
                                BorderBrush="{DynamicResource GlassBorderBrush}"
                                BorderThickness="1">
                            <TextBlock x:Name="FpsTextBlock" Text="0 FPS"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </Border>
                        <Border Background="{DynamicResource PrimaryDimBrush}"
                                CornerRadius="{StaticResource CornerSm}"
                                Padding="12,5" Margin="0,0,8,0"
                                BorderBrush="{DynamicResource GlassBorderBrush}"
                                BorderThickness="1">
                            <TextBlock x:Name="ProcessTimeTextBlock" Text="0 ms"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                        <TextBlock x:Name="SourceInfoText"
                                   Text=""
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="6,0,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="240" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
