<UserControl x:Class="VirtualPathVision.Views.ProcessingPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,4,0">
        <StackPanel>

            <!-- ═══ Card 1 — Mode Selection ═══ -->
            <Border Style="{StaticResource GlassCard}" Padding="24" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="SectionProcessingTitle"
                                   Grid.Column="0"
                                   Text="Image Processing"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />

                        <Border Grid.Column="1"
                                Background="{DynamicResource PrimaryDimBrush}"
                                CornerRadius="12"
                                Padding="12,5"
                                BorderBrush="{DynamicResource GlassBorderBrush}"
                                BorderThickness="1">
                            <TextBlock x:Name="ModeLabelText"
                                       Text="Canny"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </Border>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Mode:"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0" />

                        <ComboBox x:Name="ProcessingModeComboBox"
                                  Grid.Column="1"
                                  Style="{StaticResource GlassComboBox}"
                                  SelectedIndex="0"
                                  SelectionChanged="ProcessingModeComboBox_SelectionChanged">
                            <ComboBoxItem Content="Canny" Style="{StaticResource GlassComboBoxItem}" IsSelected="True" />
                            <ComboBoxItem Content="Sobel" Style="{StaticResource GlassComboBoxItem}" />
                            <ComboBoxItem Content="Laplacian" Style="{StaticResource GlassComboBoxItem}" />
                            <ComboBoxItem Content="Binary" Style="{StaticResource GlassComboBoxItem}" />
                            <ComboBoxItem Content="Contour" Style="{StaticResource GlassComboBoxItem}" />
                            <ComboBoxItem Content="QR Code" Style="{StaticResource GlassComboBoxItem}" />
                            <ComboBoxItem Content="Color Detection" Style="{StaticResource GlassComboBoxItem}" />
                            <ComboBoxItem Content="Template Match" Style="{StaticResource GlassComboBoxItem}" />
                            <ComboBoxItem Content="Shape Detection" Style="{StaticResource GlassComboBoxItem}" />
                            <ComboBoxItem Content="Feature Match" Style="{StaticResource GlassComboBoxItem}" />
                            <ComboBoxItem Content="Image Enhancement" Style="{StaticResource GlassComboBoxItem}" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ═══ Card 2 — Thresholds ═══ -->
            <Border x:Name="ThresholdPanel"
                    Style="{StaticResource GlassCard}"
                    Padding="20"
                    Margin="0,0,0,16"
                    Visibility="Visible">
                <StackPanel>
                    <TextBlock x:Name="ThresholdsLabel" Text="Thresholds"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,14" />

                    <!-- Threshold 1 -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Threshold 1"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBox x:Name="Threshold1TextBox"
                                 Grid.Column="1"
                                 Text="100"
                                 Style="{StaticResource GlassTextBox}"
                                 Width="64"
                                 VerticalContentAlignment="Center"
                                 HorizontalContentAlignment="Center" />
                    </Grid>
                    <Slider x:Name="Threshold1Slider"
                            Style="{StaticResource GlassSlider}"
                            Minimum="0" Maximum="255" Value="100"
                            IsSnapToTickEnabled="True" TickFrequency="1"
                            Margin="0,0,0,16"
                            ValueChanged="Threshold1Slider_ValueChanged" />

                    <!-- Threshold 2 -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Threshold 2"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBox x:Name="Threshold2TextBox"
                                 Grid.Column="1"
                                 Text="200"
                                 Style="{StaticResource GlassTextBox}"
                                 Width="64"
                                 VerticalContentAlignment="Center"
                                 HorizontalContentAlignment="Center" />
                    </Grid>
                    <Slider x:Name="Threshold2Slider"
                            Style="{StaticResource GlassSlider}"
                            Minimum="0" Maximum="255" Value="200"
                            IsSnapToTickEnabled="True" TickFrequency="1"
                            Margin="0,0,0,12"
                            ValueChanged="Threshold2Slider_ValueChanged" />

                    <Button x:Name="ApplyThresholdsButton"
                            Content="Apply"
                            Style="{StaticResource GlassButton}"
                            Click="ApplyThresholdsButton_Click"
                            HorizontalAlignment="Stretch" />
                </StackPanel>
            </Border>

            <!-- ═══ Card 3 — Color Detection ═══ -->
            <Border x:Name="ColorPanel"
                    Style="{StaticResource GlassCard}"
                    Padding="20"
                    Margin="0,0,0,16"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="ColorDetectionLabel" Text="Color Detection"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,14" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Color:"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0" />
                        <ComboBox x:Name="ColorComboBox"
                                  Grid.Column="1"
                                  Style="{StaticResource GlassComboBox}"
                                  SelectedIndex="0"
                                  SelectionChanged="ColorComboBox_SelectionChanged">
                            <ComboBoxItem Content="Red" Style="{StaticResource GlassComboBoxItem}" IsSelected="True" />
                            <ComboBoxItem Content="Green" Style="{StaticResource GlassComboBoxItem}" />
                            <ComboBoxItem Content="Blue" Style="{StaticResource GlassComboBoxItem}" />
                            <ComboBoxItem Content="Yellow" Style="{StaticResource GlassComboBoxItem}" />
                            <ComboBoxItem Content="Cyan" Style="{StaticResource GlassComboBoxItem}" />
                            <ComboBoxItem Content="Magenta" Style="{StaticResource GlassComboBoxItem}" />
                            <ComboBoxItem Content="Orange" Style="{StaticResource GlassComboBoxItem}" />
                            <ComboBoxItem Content="Custom" Style="{StaticResource GlassComboBoxItem}" />
                        </ComboBox>
                    </Grid>

                    <TextBlock x:Name="PickColorHintText"
                               Text="Click image to pick color"
                               FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,10,0,0"
                               Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- ═══ Card 4 — Template / Feature ═══ -->
            <Border x:Name="TemplatePanel"
                    Style="{StaticResource GlassCard}"
                    Padding="20"
                    Margin="0,0,0,16"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="TemplateFeatureTitle"
                               Text="Template / Feature"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,14" />

                    <Button x:Name="LoadTemplateButton"
                            Content="Load Template"
                            Style="{StaticResource GlassButton}"
                            Click="LoadTemplateButton_Click"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,12" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Status:"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBlock x:Name="TemplateStatusText"
                                   Grid.Column="1"
                                   Text="No Template"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock x:Name="FeatureMatchText"
                               Text=""
                               FontSize="13"
                               Foreground="{DynamicResource AccentBrush}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ═══ Card 5 — Result ═══ -->
            <Border Style="{StaticResource GlassCard}" Padding="20">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ResultTitle"
                                   Grid.Column="0"
                                   Text="Result"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <Border Grid.Column="1"
                                Background="{DynamicResource PrimaryDimBrush}"
                                CornerRadius="12"
                                Padding="12,5"
                                BorderBrush="{DynamicResource GlassBorderBrush}"
                                BorderThickness="1">
                            <TextBlock x:Name="ResultTitleText"
                                       Text="Result"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </Border>
                    </Grid>

                    <!-- Counters -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{DynamicResource InsetBrush}"
                                CornerRadius="{StaticResource CornerMd}"
                                Padding="14,10"
                                BorderBrush="{DynamicResource GlassBorderBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="FacesLabel" Text="Faces"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:Name="FaceCountTextBlock"
                                           Text="0"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Background="{DynamicResource InsetBrush}"
                                CornerRadius="{StaticResource CornerMd}"
                                Padding="14,10"
                                BorderBrush="{DynamicResource GlassBorderBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="ObjectsLabel" Text="Objects"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:Name="ContourCountTextBlock"
                                           Text="0"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Threshold info -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Threshold:"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBlock x:Name="ThresholdInfoText"
                                   Grid.Column="1"
                                   Text="100 ~ 200"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Border Background="{DynamicResource InsetBrush}"
                            CornerRadius="{StaticResource CornerMd}"
                            Padding="14,12"
                            BorderBrush="{DynamicResource GlassBorderBrush}"
                            BorderThickness="1">
                        <TextBlock x:Name="ModeResultTextBlock"
                                   Text=""
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
