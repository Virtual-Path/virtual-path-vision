<UserControl x:Class="VirtualPathVision.Views.ProductionLineCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Border x:Name="LineCard"
            Style="{StaticResource GlassPanel}"
            Padding="20">
        <StackPanel>

            <!-- Header -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Ellipse x:Name="LineStatusDot"
                         Grid.Column="0"
                         Width="10" Height="10"
                         Fill="{DynamicResource TextMutedBrush}"
                         Margin="0,0,10,0"
                         VerticalAlignment="Center" />

                <TextBlock x:Name="LineTitleText"
                           Grid.Column="1"
                           Text="Production Line"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />

                <!-- 启用开关：未启用时编排层不参与采集链 -->
                <ToggleButton x:Name="EnabledToggle"
                              Grid.Column="2"
                              Style="{StaticResource GlassToggleButton}"
                              ToolTip="Enable line orchestration (counting + MES)">
                    <TextBlock x:Name="EnabledLabelText" Text="Enabled" FontSize="12" />
                </ToggleButton>
            </Grid>

            <!-- Counters -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource InsetBrush}"
                        CornerRadius="{StaticResource CornerSm}" Padding="12,10">
                    <StackPanel>
                        <TextBlock x:Name="PassedLabelText" Text="Passed" FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock x:Name="PassedCountText" Text="0" FontSize="24"
                                   FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{DynamicResource InsetBrush}"
                        CornerRadius="{StaticResource CornerSm}" Padding="12,10">
                    <StackPanel>
                        <TextBlock x:Name="FailedLabelText" Text="Failed" FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock x:Name="FailedCountText" Text="0" FontSize="24"
                                   FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Background="{DynamicResource InsetBrush}"
                        CornerRadius="{StaticResource CornerSm}" Padding="12,10">
                    <StackPanel>
                        <TextBlock x:Name="YieldLabelText" Text="Yield" FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock x:Name="YieldText" Text="-" FontSize="24"
                                   FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Yield bar -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar x:Name="YieldBar" Grid.Column="0"
                             Height="8" Minimum="0" Maximum="100" Value="0"
                             VerticalAlignment="Center" />
                <TextBlock x:Name="YieldPercentText" Grid.Column="1" Text="0.0%"
                           FontSize="12" FontWeight="SemiBold" Margin="10,0,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" />
            </Grid>

            <!-- Detection settings -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="RoiLabelText" Grid.Column="0" Text="Inspection ROI"
                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,10,0" />

                <CheckBox x:Name="RoiCheckBox" Grid.Column="1"
                          IsChecked="True" VerticalAlignment="Center"
                          Checked="RoiCheckBox_Changed"
                          Unchecked="RoiCheckBox_Changed">
                    <TextBlock x:Name="RoiHintText" FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}" />
                </CheckBox>
            </Grid>

            <!-- ROI 数值：默认对准 VirtualPath-Core 虚拟相机的检测工位
                 （1280x720 下的传送带中部）。不同分辨率/相机必须重新标定，
                 所以这里做成可改，而不是写死在代码里。 -->
            <Grid x:Name="RoiValuesPanel" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="RoiValuesLabelText" Grid.Column="0" Text="ROI"
                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,10,0" />

                <TextBox x:Name="RoiXTextBox" Grid.Column="1" Text="360" Width="52"
                         Style="{StaticResource GlassTextBox}"
                         VerticalContentAlignment="Center" Margin="0,0,6,0"
                         ToolTip="Left" />
                <TextBox x:Name="RoiYTextBox" Grid.Column="2" Text="180" Width="52"
                         Style="{StaticResource GlassTextBox}"
                         VerticalContentAlignment="Center" Margin="0,0,6,0"
                         ToolTip="Top" />
                <TextBox x:Name="RoiWTextBox" Grid.Column="3" Text="560" Width="52"
                         Style="{StaticResource GlassTextBox}"
                         VerticalContentAlignment="Center" Margin="0,0,6,0"
                         ToolTip="Width" />
                <TextBox x:Name="RoiHTextBox" Grid.Column="4" Text="280" Width="52"
                         Style="{StaticResource GlassTextBox}"
                         VerticalContentAlignment="Center" Margin="0,0,10,0"
                         ToolTip="Height" />

                <TextBlock x:Name="RoiValuesHintText" Grid.Column="5" FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
            </Grid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StableFramesLabelText" Grid.Column="0" Text="Stable frames"
                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,10,0" />

                <TextBox x:Name="StableFramesTextBox" Grid.Column="1"
                         Text="3" Width="56"
                         Style="{StaticResource GlassTextBox}"
                         VerticalContentAlignment="Center" Margin="0,0,10,0" />

                <TextBlock x:Name="StableFramesHintText" Grid.Column="2"
                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
            </Grid>

            <!-- MES -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="MesLabelText" Grid.Column="0" Text="MES gateway"
                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,10,0" />

                <TextBox x:Name="MesUrlTextBox" Grid.Column="1"
                         Text="http://mes-gateway:9090"
                         Style="{StaticResource GlassTextBox}"
                         VerticalContentAlignment="Center" Margin="0,0,10,0" />

                <Border Grid.Column="2" Background="{DynamicResource InsetBrush}"
                        CornerRadius="{StaticResource CornerSm}" Padding="10,4"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="MesStateText" Text="Off" FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}" />
                </Border>
            </Grid>

            <!-- 网关 JWT：quality 路径不在白名单，缺这个头一律 401 -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="MesTokenLabelText" Grid.Column="0" Text="MES token"
                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,10,0" />

                <PasswordBox x:Name="MesTokenBox" Grid.Column="1"
                             Style="{StaticResource GlassPasswordBox}"
                             VerticalContentAlignment="Center"
                             ToolTip="JWT for the MES gateway" />
            </Grid>

            <TextBlock x:Name="LastEventText"
                       Margin="0,12,0,0"
                       Text=""
                       FontSize="11"
                       Foreground="{DynamicResource TextMutedBrush}"
                       TextTrimming="CharacterEllipsis" />

        </StackPanel>
    </Border>
</UserControl>