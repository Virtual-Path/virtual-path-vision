<Window x:Class="MachineVisionApp.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="440" Height="640"
        Background="{DynamicResource BgBrush}" WindowStyle="None" AllowsTransparency="False"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="0" ResizeBorderThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Grid Grid.Row="0" Background="{DynamicResource TitleBarBgBrush}"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <TextBlock x:Name="SettingsTitle" Text="Settings" Foreground="{DynamicResource TextPrimaryBrush}"
                       FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0"/>
            <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                    Style="{StaticResource TitleBarCloseButton}" Click="CloseButton_Click"
                    HorizontalAlignment="Right"/>
        </Grid>

        <!-- Content -->
        <Border Grid.Row="1" Background="{DynamicResource GlassBgBrush}" Margin="8" Padding="24"
                CornerRadius="12" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1">
            <StackPanel>
                <!-- Language -->
                <TextBlock Text="Language / 国际化" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="DisplayLanguageLabel" Text="Display Language:" FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ComboBox x:Name="LanguageComboBox" Grid.Column="1"
                              Style="{StaticResource GlassComboBox}"
                              SelectionChanged="LanguageComboBox_SelectionChanged">
                        <ComboBoxItem Content="English" Tag="en-US" IsSelected="True"/>
                        <ComboBoxItem Content="中文 (Chinese)" Tag="zh-CN"/>
                    </ComboBox>
                </Grid>

                <!-- Theme Settings -->
                <TextBlock Text="Theme / 主题" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,20,0,12"/>
                <TextBlock Text="选择外观 / Choose your preferred appearance. '跟随系统' 将随 Windows 设置自动切换。"
                           FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,12"
                           TextWrapping="Wrap"/>
                <StackPanel>
                    <RadioButton x:Name="LightThemeRadio" Content="浅色 Light"
                                 Style="{StaticResource GlassRadioButton}" Margin="0,0,0,8"
                                 Checked="ThemeRadio_Checked" Tag="Light"/>
                    <RadioButton x:Name="DarkThemeRadio" Content="深色 Dark"
                                 Style="{StaticResource GlassRadioButton}" Margin="0,0,0,8"
                                 Checked="ThemeRadio_Checked" Tag="Dark"/>
                    <RadioButton x:Name="SystemThemeRadio" Content="跟随系统 System"
                                 Style="{StaticResource GlassRadioButton}" Margin="0,0,0,8"
                                 Checked="ThemeRadio_Checked" Tag="System"/>
                </StackPanel>

                <!-- About -->
                <Border Height="1" Background="{DynamicResource GlassDividerBrush}" Margin="0,20"/>
                <TextBlock Text="About" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,16,0,12"/>

                <TextBlock x:Name="AboutAppName" Text="Machine Vision App"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                <TextBlock x:Name="AboutVersion" Text="v3.1.0" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>

                <TextBlock Text="OpenCV 5 · AWS Cloud · AI Active Perception" FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" TextWrapping="Wrap"/>
                <TextBlock Text="WPF · OpenCvSharp5 · .NET 8 · ZXing.Net · NModbus · OPC UA" FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>

                <TextBlock Text="OpenCV AI Competition 2026" FontSize="12"
                           Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0,0,0,10"/>

                <TextBlock FontSize="12" Margin="0,0,0,6">
                    <Hyperlink x:Name="AboutLink"
                               NavigateUri="https://github.com/xianshi3/machine-vision-app"
                               RequestNavigate="AboutLink_RequestNavigate">github.com/xianshi3/machine-vision-app</Hyperlink>
                </TextBlock>

                <TextBlock Text="GPL-3.0 · © 2026 xianshi3 and contributors" FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}"/>
            </StackPanel>
        </Border>

        <!-- Bottom bar -->
        <Border Grid.Row="2" Background="{DynamicResource StatusBarBgBrush}"
                BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,1,0,0"
                Padding="16,8" CornerRadius="0,0,8,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SettingsCloseButton" Content="Close" Style="{StaticResource GlassButton}"
                        Padding="20,8" Click="CloseButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
