<Window x:Class="MachineVisionApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MachineVisionApp"
        xmlns:views="clr-namespace:MachineVisionApp.Views"
        Title="MachineVisionApp" WindowState="Normal" WindowStyle="None" AllowsTransparency="False"
        Width="1400" Height="850" MinWidth="900" MinHeight="600"
        Background="#040404" ResizeMode="CanResizeWithGrip">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="0" ResizeBorderThickness="8"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="84"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Sidebar — glass panel with backdrop ===== -->
        <Border Grid.Column="0" BorderThickness="0,0,1,0"
                BorderBrush="{StaticResource GlassBorderBrush}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#CC0A0908" Offset="0"/>
                    <GradientStop Color="#B30C0B0A" Offset="0.5"/>
                    <GradientStop Color="#CC0A0908" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel>
                <!-- Logo — glass icon badge -->
                <Border DockPanel.Dock="Top" Height="80" Margin="0,14,0,4"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#00788F94" Offset="0"/>
                                <GradientStop Color="#0D788F94" Offset="1"/>
                            </LinearGradientBrush>
                        </Grid.Background>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Width="38" Height="38" CornerRadius="11"
                                    HorizontalAlignment="Center" Margin="0,0,0,6"
                                    Background="#1A788F94" BorderBrush="#33788F94"
                                    BorderThickness="1.5">
                                <TextBlock Text="MV" FontSize="13" FontWeight="Black"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="V I S I O N" FontSize="7" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Divider -->
                <Border DockPanel.Dock="Top" Height="1" Margin="16,0,16,10"
                        Background="{StaticResource GlassDividerBrush}"/>

                <!-- Nav Icons -->
                <StackPanel DockPanel.Dock="Top">
                    <RadioButton x:Name="NavVision" Content="&#xE8B4;" FontFamily="Segoe MDL2 Assets"
                                 FontSize="18" IsChecked="True" GroupName="Nav"
                                 Click="NavButton_Click" Tag="Vision"
                                 Style="{StaticResource SidebarNavRadio}" Margin="0,0,0,4"/>
                    <RadioButton x:Name="NavProcessing" Content="&#xE74F;" FontFamily="Segoe MDL2 Assets"
                                 FontSize="18" GroupName="Nav"
                                 Click="NavButton_Click" Tag="Processing"
                                 Style="{StaticResource SidebarNavRadio}" Margin="0,0,0,4"/>
                    <RadioButton x:Name="NavAI" Content="&#xE99A;" FontFamily="Segoe MDL2 Assets"
                                 FontSize="18" GroupName="Nav"
                                 Click="NavButton_Click" Tag="AI"
                                 Style="{StaticResource SidebarNavRadio}" Margin="0,0,0,4"/>
                    <RadioButton x:Name="NavCloud" Content="&#xE753;" FontFamily="Segoe MDL2 Assets"
                                 FontSize="18" GroupName="Nav"
                                 Click="NavButton_Click" Tag="Cloud"
                                 Style="{StaticResource SidebarNavRadio}" Margin="0,0,0,4"/>
                    <RadioButton x:Name="NavIndustrial" Content="&#xE774;" FontFamily="Segoe MDL2 Assets"
                                 FontSize="18" GroupName="Nav"
                                 Click="NavButton_Click" Tag="Industrial"
                                 Style="{StaticResource SidebarNavRadio}" Margin="0,0,0,4"/>
                    <RadioButton x:Name="NavLog" Content="&#xE7BA;" FontFamily="Segoe MDL2 Assets"
                                 FontSize="18" GroupName="Nav"
                                 Click="NavButton_Click" Tag="Log"
                                 Style="{StaticResource SidebarNavRadio}" Margin="0,0,0,4"/>
                </StackPanel>

                <!-- Divider -->
                <Border DockPanel.Dock="Top" Height="1" Margin="16,6,16,0"
                        Background="{StaticResource GlassDividerBrush}"/>

                <!-- Settings at bottom -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,14"
                            HorizontalAlignment="Center">
                    <Button x:Name="SettingsButton" Content="&#xE713;" FontFamily="Segoe MDL2 Assets"
                            FontSize="16" Style="{StaticResource SidebarIconButton}"
                            Click="SettingsButton_Click" ToolTip="Settings"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Main Content Area ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar (draggable) -->
            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#A00C0B0A" Offset="0"/>
                        <GradientStop Color="#800C0B0A" Offset="0.5"/>
                        <GradientStop Color="#A00C0B0A" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Ellipse x:Name="ConnectionIndicator" Width="7" Height="7" Fill="#5F554C" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusText" Text="Disconnected" Foreground="{StaticResource TextMutedBrush}"
                               FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="&#xE949;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Style="{StaticResource TitleBarButton}" Click="MinimizeButton_Click"/>
                    <Button x:Name="MaximizeBtn" Content="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Style="{StaticResource TitleBarButton}" Click="MaximizeButton_Click"/>
                    <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Style="{StaticResource TitleBarCloseButton}" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- Content Panels -->
            <Grid Grid.Row="1" Margin="6">
                <Grid.Background>
                    <RadialGradientBrush RadiusX="0.8" RadiusY="0.8">
                        <GradientStop Color="#1A1612" Offset="0"/>
                        <GradientStop Color="#040404" Offset="1"/>
                    </RadialGradientBrush>
                </Grid.Background>
                <views:CameraPanel x:Name="CameraPanelCtrl" Visibility="Visible"/>
                <views:ProcessingPanel x:Name="ProcessingPanelCtrl" Visibility="Collapsed"/>
                <views:AIPanel x:Name="AIPanelCtrl" Visibility="Collapsed"/>
                <views:CloudPanel x:Name="CloudPanelCtrl" Visibility="Collapsed"/>
                <views:IndustrialPanel x:Name="IndustrialPanelCtrl" Visibility="Collapsed"/>
                <views:LogPanel x:Name="LogPanelCtrl" Visibility="Collapsed"/>
            </Grid>

            <!-- Status Bar — glass panel -->
            <Border Grid.Row="2" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="0,1,0,0"
                    Padding="16,7,16,7" CornerRadius="0,0,8,8">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#D9070605" Offset="0"/>
                        <GradientStop Color="#E6090807" Offset="0.5"/>
                        <GradientStop Color="#D9070605" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Ellipse x:Name="StatusIndicator" Width="5" Height="5" Fill="#5F554C"
                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="StatusTextFooter" Text="Ready"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" x:Name="FpsTextBlock" Text="0 FPS"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                               VerticalAlignment="Center" Margin="16,0,0,0" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="2" x:Name="ProcessTimeTextBlock" Text="0 ms"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBlock Grid.Column="3" x:Name="CameraDataTextBlock" Text=""
                               Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>

                    <TextBlock Grid.Column="5" Text="OpenCV 5 + AWS" Foreground="#33C4B7A7"
                               FontSize="10" VerticalAlignment="Center" FontWeight="Light"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Error Banner — toast style, top of content area with margin -->
        <Border x:Name="ErrorBorder" Grid.Column="1" Grid.Row="1" VerticalAlignment="Top" Margin="12,12,12,0"
                Background="#E0131110" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1,1,1,3"
                Padding="16,10" Visibility="Collapsed" Panel.ZIndex="100" CornerRadius="8"
                RenderTransformOrigin="0.5,0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ErrorTranslateY" Y="-40"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect Color="#000000" ShadowDepth="4" BlurRadius="16" Opacity="0.4" Direction="270"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ErrorMessageTextBlock" Text="" Foreground="{StaticResource DangerBrush}"
                           FontSize="12" VerticalAlignment="Center" FontWeight="Medium"/>
                <Button Content="X" Margin="12,0,0,0" Background="Transparent"
                        Foreground="{StaticResource TextMutedBrush}"
                        BorderThickness="0" Cursor="Hand" FontSize="12" FontWeight="Bold"
                        Click="HideErrorButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
