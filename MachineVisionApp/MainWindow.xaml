<Window x:Class="MachineVisionApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MachineVisionApp"
        xmlns:views="clr-namespace:MachineVisionApp.Views"
        Title="MachineVisionApp" WindowState="Maximized"
        Background="#0A0F19" WindowStyle="None" AllowsTransparency="False"
        ResizeMode="CanResizeWithGrip">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="0" ResizeBorderThickness="8"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="84"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Sidebar Navigation ===== -->
        <Border Grid.Column="0" Background="#C0101624" BorderBrush="#14FFFFFF" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Logo -->
                <Border DockPanel.Dock="Top" Height="70" Margin="0,16,0,30">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="MV" FontSize="22" FontWeight="Black" Foreground="#FAE20A"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="V I S I O N" FontSize="8" Foreground="#7A8B9E"
                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Nav Icons -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,0">
                    <RadioButton x:Name="NavVision" Content="&#xE8B4;" FontFamily="Segoe MDL2 Assets"
                                 FontSize="20" IsChecked="True" GroupName="Nav"
                                 Click="NavButton_Click" Tag="Vision"
                                 Width="52" Height="52" Margin="0,0,0,8"
                                 HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                 Cursor="Hand"/>
                    <RadioButton x:Name="NavProcessing" Content="&#xE74F;" FontFamily="Segoe MDL2 Assets"
                                 FontSize="20" GroupName="Nav"
                                 Click="NavButton_Click" Tag="Processing"
                                 Width="52" Height="52" Margin="0,0,0,8"
                                 HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                 Cursor="Hand"/>
                    <RadioButton x:Name="NavAI" Content="&#xE99A;" FontFamily="Segoe MDL2 Assets"
                                 FontSize="20" GroupName="Nav"
                                 Click="NavButton_Click" Tag="AI"
                                 Width="52" Height="52" Margin="0,0,0,8"
                                 HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                 Cursor="Hand"/>
                    <RadioButton x:Name="NavCloud" Content="&#xE753;" FontFamily="Segoe MDL2 Assets"
                                 FontSize="20" GroupName="Nav"
                                 Click="NavButton_Click" Tag="Cloud"
                                 Width="52" Height="52" Margin="0,0,0,8"
                                 HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                 Cursor="Hand"/>
                    <RadioButton x:Name="NavIndustrial" Content="&#xE774;" FontFamily="Segoe MDL2 Assets"
                                 FontSize="20" GroupName="Nav"
                                 Click="NavButton_Click" Tag="Industrial"
                                 Width="52" Height="52" Margin="0,0,0,8"
                                 HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                 Cursor="Hand"/>
                    <RadioButton x:Name="NavLog" Content="&#xE7BA;" FontFamily="Segoe MDL2 Assets"
                                 FontSize="20" GroupName="Nav"
                                 Click="NavButton_Click" Tag="Log"
                                 Width="52" Height="52" Margin="0,0,0,8"
                                 HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                 Cursor="Hand"/>
                </StackPanel>

                <!-- Bottom icons -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,20"
                            HorizontalAlignment="Center">
                    <Button x:Name="SettingsButton" Content="&#xE713;" FontFamily="Segoe MDL2 Assets"
                            FontSize="18" Width="40" Height="40" Background="Transparent"
                            Foreground="#7A8B9E" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Main Content Area ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" Background="#80101624">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Ellipse x:Name="ConnectionIndicator" Width="8" Height="8" Fill="#484F58" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusText" Text="Disconnected" Foreground="#7A8B9E" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="&#xE949;" FontFamily="Segoe MDL2 Assets" FontSize="10" Width="46" Height="32"
                            Background="Transparent" Foreground="#7A8B9E" BorderThickness="0" Click="MinimizeButton_Click" Cursor="Hand"/>
                    <Button x:Name="MaximizeBtn" Content="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10" Width="46" Height="32"
                            Background="Transparent" Foreground="#7A8B9E" BorderThickness="0" Click="MaximizeButton_Click" Cursor="Hand"/>
                    <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" Width="46" Height="32"
                            Background="Transparent" Foreground="#7A8B9E" BorderThickness="0" Click="CloseButton_Click" Cursor="Hand"/>
                </StackPanel>
            </Grid>

            <!-- Content Panels (switched by sidebar) -->
            <Grid Grid.Row="1" Margin="0">
                <views:CameraPanel x:Name="CameraPanelCtrl" Visibility="Visible"/>
                <views:ProcessingPanel x:Name="ProcessingPanelCtrl" Visibility="Collapsed"/>
                <views:AIPanel x:Name="AIPanelCtrl" Visibility="Collapsed"/>
                <views:CloudPanel x:Name="CloudPanelCtrl" Visibility="Collapsed"/>
                <views:IndustrialPanel x:Name="IndustrialPanelCtrl" Visibility="Collapsed"/>
                <views:LogPanel x:Name="LogPanelCtrl" Visibility="Collapsed"/>
            </Grid>

            <!-- Status Bar -->
            <Border Grid.Row="2" Background="#80101624" BorderBrush="#14FFFFFF" BorderThickness="0,1,0,0"
                    Padding="20,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Ellipse x:Name="StatusIndicator" Width="6" Height="6" Fill="#484F58" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="StatusTextFooter" Text="Ready" Foreground="#7A8B9E" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" x:Name="FpsTextBlock" Text="0 FPS" Foreground="#D1D9E6" FontSize="11"
                               VerticalAlignment="Center" Margin="20,0,0,0" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="2" x:Name="ProcessTimeTextBlock" Text="0 ms" Foreground="#7A8B9E" FontSize="11"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <TextBlock Grid.Column="3" x:Name="CameraDataTextBlock" Text="" Foreground="#7A8B9E" FontSize="11"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>

                    <TextBlock Grid.Column="5" Text="OpenCV 5 + AWS" Foreground="#484F58" FontSize="10"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Error Banner -->
        <Border x:Name="ErrorBorder" Grid.Column="1" Grid.Row="1" VerticalAlignment="Top"
                Background="#40F85149" BorderBrush="#F85149" BorderThickness="0,0,0,2"
                Padding="16,8" Visibility="Collapsed" Panel.ZIndex="100">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ErrorMessageTextBlock" Text="" Foreground="#F85149" FontSize="12" VerticalAlignment="Center"/>
                <Button Content="X" Margin="12,0,0,0" Background="Transparent" Foreground="#F85149"
                        BorderThickness="0" Cursor="Hand" FontSize="12" FontWeight="Bold"
                        Click="HideErrorButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
