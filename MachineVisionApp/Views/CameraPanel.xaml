<UserControl x:Class="MachineVisionApp.Views.CameraPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgDarkBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Border Style="{StaticResource GlassPanel}"
                Margin="0"
                Padding="28">

            <StackPanel>

                <!-- ═══ Camera Connection ═══ -->
                <StackPanel >

                    <!-- Header Row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="SectionTitleText"
                                   Grid.Column="0"
                                   Text="Camera"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0" />

                        <Ellipse x:Name="ConnectionDot"
                                 Grid.Column="1"
                                 Width="10"
                                 Height="10"
                                 Fill="{StaticResource DangerBrush}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#C4675C"
                                                  ShadowDepth="0"
                                                  BlurRadius="8"
                                                  Opacity="0.6" />
                            </Ellipse.Effect>
                        </Ellipse>

                        <TextBlock x:Name="ConnectionStatusText"
                                   Grid.Column="2"
                                   Text="Disconnected"
                                   FontSize="13"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <!-- Source Type Row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="SourceLabel"
                                   Grid.Column="0"
                                   Text="Source:"
                                   FontSize="14"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />

                        <ComboBox x:Name="SourceTypeComboBox"
                                  Grid.Column="1"
                                  Style="{StaticResource GlassComboBox}"
                                  SelectedIndex="0"
                                  SelectionChanged="SourceTypeComboBox_SelectionChanged">
                            <ComboBoxItem Content="Local Camera"
                                          Style="{StaticResource GlassComboBoxItem}"
                                          IsSelected="True" />
                            <ComboBoxItem Content="Network Stream"
                                          Style="{StaticResource GlassComboBoxItem}" />
                        </ComboBox>
                    </Grid>

                    <!-- Network Config Panel -->
                    <Border x:Name="NetworkConfigPanel"
                            Visibility="Collapsed"
                            Background="#14C4B7A7"
                            CornerRadius="{StaticResource CornerSm}"
                            Padding="16"
                            BorderBrush="{StaticResource GlassBorderBrush}"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal"
                                    
                                    VerticalAlignment="Center">

                            <TextBlock x:Name="CameraIpLabel" Text="IP:"
                                       FontSize="13"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,4,0" />

                            <TextBox x:Name="IPTextBox"
                                     Text="127.0.0.1"
                                     Style="{StaticResource GlassTextBox}"
                                     Width="160"
                                     VerticalContentAlignment="Center" />

                            <TextBlock Text=":"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center" />

                            <TextBox x:Name="PortTextBox"
                                     Text="8080"
                                     Style="{StaticResource GlassTextBox}"
                                     Width="80"
                                     VerticalContentAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Button Row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="ConnectButton"
                                Grid.Column="0"
                                Content="Connect"
                                Style="{StaticResource AccentButton}"
                                Click="ConnectButton_Click"
                                Margin="0,0,8,0" />

                        <Button x:Name="DisconnectButton"
                                Grid.Column="1"
                                Content="Disconnect"
                                Style="{StaticResource DangerButton}"
                                IsEnabled="False"
                                Click="DisconnectButton_Click"
                                Margin="0,0,8,0" />

                        <Button x:Name="LoadImageButton"
                                Grid.Column="2"
                                Content="Load Image"
                                Style="{StaticResource GlassButton}"
                                Click="LoadImageButton_Click" />
                    </Grid>
                </StackPanel>

                <!-- Thin divider -->
                <Border Height="1"
                        Background="{StaticResource GlassDividerBrush}"
                        Margin="0,2" />

                <!-- ═══ Camera Quick Controls ═══ -->
                <StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="StartCameraButton"
                                Grid.Column="0"
                                Content="Start Camera"
                                Style="{StaticResource AccentButton}"
                                Click="StartCameraButton_Click"
                                Margin="0,0,8,0" />

                        <Button x:Name="StopCameraButton"
                                Grid.Column="1"
                                Content="Stop Camera"
                                Style="{StaticResource DangerButton}"
                                IsEnabled="False"
                                Click="StopCameraButton_Click"
                                Margin="0,0,8,0" />

                        <Button x:Name="SaveScreenshotButton"
                                Grid.Column="2"
                                Content="Screenshot"
                                Style="{StaticResource GlassButton}"
                                Click="SaveScreenshotButton_Click"
                                Margin="0,0,8,0" />

                        <Button x:Name="RecordButton"
                                Grid.Column="3"
                                Content="Record"
                                Style="{StaticResource GlassButton}"
                                Click="RecordButton_Click" />
                    </Grid>
                </StackPanel>

                <!-- Thin divider -->
                <Border Height="1"
                        Background="{StaticResource GlassBorderBrush}"
                        Margin="0,2" />

                <!-- ═══ Display Area ═══ -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Original Image -->
                    <Border Grid.Column="0"
                            Background="#14C4B7A7"
                            BorderBrush="{StaticResource GlassBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CornerMd}"
                            Margin="0,0,6,0"
                            MinHeight="300"
                            ClipToBounds="True">
                        <Grid>
                            <Image x:Name="OriginalImage"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" />

                            <!-- Empty overlay -->
                            <StackPanel x:Name="EmptyOverlayLeft"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="&#x1F4F7;"
                                           FontSize="36"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Center"
                                           Opacity="0.4" />
                                <TextBlock x:Name="NoSignalOriginalText" Text="No Signal"
                                           FontSize="14"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Result / Edge Image -->
                    <Border Grid.Column="1"
                            Background="#14C4B7A7"
                            BorderBrush="{StaticResource GlassBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CornerMd}"
                            Margin="6,0,0,0"
                            MinHeight="300"
                            ClipToBounds="True">
                        <Grid>
                            <Image x:Name="EdgeImage"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" />

                            <!-- Empty overlay -->
                            <StackPanel x:Name="EmptyOverlayRight"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="&#x2699;"
                                           FontSize="36"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Center"
                                           Opacity="0.4" />
                                <TextBlock x:Name="NoSignalEdgeText" Text="No Signal"
                                           FontSize="14"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ═══ Data Row ═══ -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="#14C4B7A7"
                            CornerRadius="{StaticResource CornerSm}"
                            Padding="14,6"
                            BorderBrush="{StaticResource GlassBorderBrush}"
                            BorderThickness="1"
                            Margin="0,0,8,0">
                        <TextBlock x:Name="FpsTextBlock"
                                   Text="0 FPS"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}" />
                    </Border>

                    <Border Grid.Column="1"
                            Background="#14C4B7A7"
                            CornerRadius="{StaticResource CornerSm}"
                            Padding="14,6"
                            BorderBrush="{StaticResource GlassBorderBrush}"
                            BorderThickness="1"
                            Margin="0,0,8,0">
                        <TextBlock x:Name="ProcessTimeTextBlock"
                                   Text="0 ms"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </Border>

                    <TextBlock x:Name="SourceInfoText"
                               Grid.Column="2"
                               Text=""
                               FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right" />
                </Grid>

            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
