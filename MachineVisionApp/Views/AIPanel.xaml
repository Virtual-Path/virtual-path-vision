<UserControl x:Class="MachineVisionApp.Views.AIPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgDarkBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ═══════════════════════════════════════════════════════════
                 LEFT COLUMN — YOLO Detection + Controls
                 ═══════════════════════════════════════════════════════════ -->
            <StackPanel Grid.Column="0" Margin="0,0,12,0">

                <!-- ── AI Detection Header ── -->
                <Border Style="{StaticResource GlassPanel}" Padding="20" Margin="0,0,0,16">
                    <StackPanel>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Ellipse x:Name="AiStatusDot"
                                     Grid.Column="0"
                                     Width="10"
                                     Height="10"
                                     Fill="{DynamicResource TextMutedBrush}"
                                     Margin="0,0,10,0"
                                     VerticalAlignment="Center" />

                            <TextBlock x:Name="SectionAITitle"
                                       Grid.Column="1"
                                       Text="AI Detection (YOLO)"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />

                            <TextBlock x:Name="AiStatusText"
                                       Grid.Column="2"
                                       Text="Not Loaded"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <!-- Model Loading Row -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="LoadYoloModelButton"
                                    Grid.Column="0"
                                    Content="Load Model"
                                    Style="{StaticResource AccentButton}"
                                    Padding="14,8"
                                    FontSize="13"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center" />

                            <Border Grid.Column="1"
                                    Background="#14FFFFFF"
                                    CornerRadius="{StaticResource CornerMd}"
                                    Padding="14,8"
                                    BorderBrush="{DynamicResource GlassBorderBrush}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="YoloModelPathText"
                                           Text="No model loaded"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                            </Border>
                        </Grid>

                        <!-- Confidence Row -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="ConfidenceLabel"
                                       Grid.Column="0"
                                       Text="Confidence:"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />

                            <TextBox x:Name="ConfThresholdTextBox"
                                     Grid.Column="1"
                                     Text="0.5"
                                     Style="{StaticResource GlassTextBox}"
                                     Width="80"
                                     FontSize="13"
                                     VerticalContentAlignment="Center"
                                     HorizontalContentAlignment="Center" />

                            <CheckBox x:Name="AiEnableCheckBox"
                                      Grid.Column="2"
                                      Content="Enable"
                                      Style="{StaticResource GlassCheckBox}"
                                      Margin="16,0,0,0"
                                      VerticalAlignment="Center" />
                        </Grid>

                        <!-- Detection Stats Row -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="#14FFFFFF"
                                    CornerRadius="{StaticResource CornerSm}"
                                    Padding="14,6"
                                    BorderBrush="{DynamicResource GlassBorderBrush}"
                                    BorderThickness="1"
                                    Margin="0,0,8,0">
                                <TextBlock x:Name="AiDetectionsText"
                                           Text="Detections: 0"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>

                            <Border Grid.Column="1"
                                    Background="#14FFFFFF"
                                    CornerRadius="{StaticResource CornerSm}"
                                    Padding="14,6"
                                    BorderBrush="{DynamicResource GlassBorderBrush}"
                                    BorderThickness="1"
                                    Margin="0,0,8,0">
                                <TextBlock x:Name="AiTracksText"
                                           Text="Tracks: 0"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>

                            <Border Grid.Column="2"
                                    Background="#14FFFFFF"
                                    CornerRadius="{StaticResource CornerSm}"
                                    Padding="14,6"
                                    BorderBrush="{DynamicResource GlassBorderBrush}"
                                    BorderThickness="1">
                                <TextBlock x:Name="AiSampleText"
                                           Text="Interval: 1"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                        </Grid>

                    </StackPanel>
                </Border>

                <!-- ── Digital Twin Preview ── -->
                <Border Style="{StaticResource GlassPanel}" Padding="20">
                    <StackPanel>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="SectionDigitalTwinTitle"
                                       Grid.Column="0"
                                       Text="Digital Twin"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />

                            <TextBlock x:Name="TwinStatusText"
                                       Grid.Column="1"
                                       Text=""
                                       FontSize="13"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <Border Background="#14FFFFFF"
                                CornerRadius="{StaticResource CornerMd}"
                                Padding="2"
                                BorderBrush="{DynamicResource GlassBorderBrush}"
                                BorderThickness="1"
                                Height="200"
                                Margin="0,0,0,12">
                            <Image x:Name="DigitalTwinImage"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>

                        <!-- Twin Stats -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="#14FFFFFF"
                                    CornerRadius="{StaticResource CornerSm}"
                                    Padding="14,6"
                                    BorderBrush="{DynamicResource GlassBorderBrush}"
                                    BorderThickness="1"
                                    Margin="0,0,8,0">
                                <TextBlock x:Name="TwinDetectionsText"
                                           Text="Detections: 0"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>

                            <Border Grid.Column="1"
                                    Background="#14FFFFFF"
                                    CornerRadius="{StaticResource CornerSm}"
                                    Padding="14,6"
                                    BorderBrush="{DynamicResource GlassBorderBrush}"
                                    BorderThickness="1"
                                    Margin="0,0,8,0">
                                <TextBlock x:Name="TwinDefectsText"
                                           Text="Defects: 0"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>

                            <Border Grid.Column="2"
                                    Background="#14FFFFFF"
                                    CornerRadius="{StaticResource CornerSm}"
                                    Padding="14,6"
                                    BorderBrush="{DynamicResource GlassBorderBrush}"
                                    BorderThickness="1">
                                <TextBlock x:Name="TwinPassRateText"
                                           Text="Pass: 100%"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                        </Grid>

                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- Thin vertical divider -->
            <Border Grid.Column="1"
                    Width="1"
                    Background="{DynamicResource GlassBorderBrush}"
                    Margin="0,12"
                    VerticalAlignment="Stretch" />

            <!-- ═══════════════════════════════════════════════════════════
                 RIGHT COLUMN — Active Perception Details
                 ═══════════════════════════════════════════════════════════ -->
            <StackPanel Grid.Column="2" Margin="12,0,0,0">

                <!-- ── Active Perception Header ── -->
                <Border Style="{StaticResource GlassPanel}" Padding="20">
                    <StackPanel>

                        <TextBlock x:Name="SectionActivePerceptionTitle"
                                   Text="Active Perception"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,16" />

                        <!-- Stats Grid -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Frame Count -->
                            <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,8,8">
                                <TextBlock x:Name="FrameCountLabel"
                                           Text="Frame Count:"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,0,0,4" />
                                <Border Background="#14FFFFFF"
                                        CornerRadius="{StaticResource CornerSm}"
                                        Padding="14,8"
                                        BorderBrush="{DynamicResource GlassBorderBrush}"
                                        BorderThickness="1">
                                    <TextBlock x:Name="AiFrameCountText"
                                               Text="0"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               HorizontalAlignment="Center" />
                                </Border>
                            </StackPanel>

                            <!-- Active Tracks -->
                            <StackPanel Grid.Column="1" Grid.Row="0" Margin="8,0,0,8">
                                <TextBlock x:Name="ActiveTracksLabel"
                                           Text="Active Tracks:"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,0,0,4" />
                                <Border Background="#14FFFFFF"
                                        CornerRadius="{StaticResource CornerSm}"
                                        Padding="14,8"
                                        BorderBrush="{DynamicResource GlassBorderBrush}"
                                        BorderThickness="1">
                                    <TextBlock x:Name="AiActiveTracksText"
                                               Text="0"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               HorizontalAlignment="Center" />
                                </Border>
                            </StackPanel>

                            <!-- Lost Tracks -->
                            <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,8,8">
                                <TextBlock x:Name="LostTracksLabel"
                                           Text="Lost Tracks:"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,0,0,4" />
                                <Border Background="#14FFFFFF"
                                        CornerRadius="{StaticResource CornerSm}"
                                        Padding="14,8"
                                        BorderBrush="{DynamicResource GlassBorderBrush}"
                                        BorderThickness="1">
                                    <TextBlock x:Name="AiLostTracksText"
                                               Text="0"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               HorizontalAlignment="Center" />
                                </Border>
                            </StackPanel>

                            <!-- Adaptive Interval -->
                            <StackPanel Grid.Column="1" Grid.Row="1" Margin="8,0,0,8">
                                <TextBlock x:Name="AdaptiveIntervalLabel"
                                           Text="Adaptive Interval:"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,0,0,4" />
                                <Border Background="#14FFFFFF"
                                        CornerRadius="{StaticResource CornerSm}"
                                        Padding="14,8"
                                        BorderBrush="{DynamicResource GlassBorderBrush}"
                                        BorderThickness="1">
                                    <TextBlock x:Name="AiIntervalText"
                                               Text="1"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               HorizontalAlignment="Center" />
                                </Border>
                            </StackPanel>

                            <!-- ROI Regions -->
                            <StackPanel Grid.Column="0" Grid.Row="2" Margin="0,0,8,0">
                                <TextBlock x:Name="RoiRegionsLabel"
                                           Text="ROI Regions:"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,0,0,4" />
                                <Border Background="#14FFFFFF"
                                        CornerRadius="{StaticResource CornerSm}"
                                        Padding="14,8"
                                        BorderBrush="{DynamicResource GlassBorderBrush}"
                                        BorderThickness="1">
                                    <TextBlock x:Name="AiRoiCountText"
                                               Text="0"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               HorizontalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Per-Class Detection Breakdown -->
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock x:Name="SectionBreakdownTitle"
                                       Text="Detection Breakdown"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,0,8" />

                            <Border x:Name="DetectionBreakdownPanel"
                                    Background="#14FFFFFF"
                                    CornerRadius="{StaticResource CornerMd}"
                                    Padding="14"
                                    BorderBrush="{DynamicResource GlassBorderBrush}"
                                    BorderThickness="1"
                                    MaxHeight="180">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <TextBlock x:Name="DetectionBreakdownText"
                                               Text="No detections yet"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               TextWrapping="Wrap" />
                                </ScrollViewer>
                            </Border>
                        </StackPanel>

                        <!-- Tracking Trail Section -->
                        <StackPanel>
                            <TextBlock x:Name="SectionTrackingTitle"
                                       Text="Tracking Trail"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,0,10" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock x:Name="MaxTrailLabel"
                                               Text="Max Trail Length:"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,0,0,4" />
                                    <TextBox x:Name="MaxTrailTextBox"
                                             Text="30"
                                             Style="{StaticResource GlassTextBox}"
                                             FontSize="13"
                                             VerticalContentAlignment="Center"
                                             HorizontalContentAlignment="Center" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock x:Name="MatchThresholdLabel"
                                               Text="Match Threshold:"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,0,0,4" />
                                    <TextBox x:Name="MatchThresholdTextBox"
                                             Text="80"
                                             Style="{StaticResource GlassTextBox}"
                                             FontSize="13"
                                             VerticalContentAlignment="Center"
                                             HorizontalContentAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                    </StackPanel>
                </Border>

            </StackPanel>

        </Grid>
    </ScrollViewer>
</UserControl>
