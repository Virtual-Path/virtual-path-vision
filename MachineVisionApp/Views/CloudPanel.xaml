<UserControl x:Class="MachineVisionApp.Views.CloudPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgDarkBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ═══════════════════════════════════════════════════════════
                 LEFT COLUMN — S3 Storage
                 ═══════════════════════════════════════════════════════════ -->
            <Border Grid.Column="0" Grid.Row="0" Style="{StaticResource GlassPanel}" Padding="20" Margin="0,0,12,0">
                <StackPanel>

                    <!-- Header -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Ellipse x:Name="S3StatusDot"
                                 Grid.Column="0"
                                 Width="10"
                                 Height="10"
                                 Fill="{DynamicResource TextMutedBrush}"
                                 Margin="0,0,10,0"
                                 VerticalAlignment="Center" />

                        <TextBlock x:Name="SectionS3Title"
                                   Grid.Column="1"
                                   Text="AWS S3 Storage"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />

                        <TextBlock x:Name="S3StatusText"
                                   Grid.Column="2"
                                   Text="Not Configured"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <!-- Bucket -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock x:Name="BucketLabel"
                                   Text="Bucket:"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,6" />
                        <TextBox x:Name="S3BucketTextBox"
                                 Text=""
                                 Style="{StaticResource GlassTextBox}"
                                 FontSize="13"
                                 VerticalContentAlignment="Center" />
                    </StackPanel>

                    <!-- Region -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock x:Name="RegionLabel"
                                   Text="Region:"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,6" />
                        <TextBox x:Name="AwsRegionTextBox"
                                 Text="ap-northeast-1"
                                 Style="{StaticResource GlassTextBox}"
                                 FontSize="13"
                                 VerticalContentAlignment="Center" />
                    </StackPanel>

                    <!-- Upload Button -->
                    <Button x:Name="CloudUploadScreenshotButton"
                            Content="Upload Screenshot"
                            Style="{StaticResource AccentButton}"
                            Padding="14,8"
                            FontSize="13"
                            IsEnabled="False"
                            Margin="0,0,0,12" />

                    <!-- Upload Status -->
                    <TextBlock x:Name="S3UploadStatusText"
                               Text=""
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,12"
                               TextWrapping="Wrap" />

                    <!-- Recent Uploads -->
                    <StackPanel Margin="0,0,0,4">
                        <TextBlock x:Name="RecentUploadsLabel"
                                   Text="Recent Uploads"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,8" />
                        <Border Background="#14FFFFFF"
                                CornerRadius="{StaticResource CornerMd}"
                                Padding="14"
                                BorderBrush="{DynamicResource GlassBorderBrush}"
                                BorderThickness="1"
                                MaxHeight="180">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <TextBlock x:Name="S3UploadListText"
                                           Text="No uploads yet"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- Thin vertical divider -->
            <Border Grid.Column="1"
                    Grid.Row="0"
                    Width="1"
                    Background="{DynamicResource GlassBorderBrush}"
                    Margin="0,12"
                    VerticalAlignment="Stretch" />

            <!-- ═══════════════════════════════════════════════════════════
                 CENTER COLUMN — IoT Core
                 ═══════════════════════════════════════════════════════════ -->
            <Border Grid.Column="2" Grid.Row="0" Style="{StaticResource GlassPanel}" Padding="20" Margin="12,0">
                <StackPanel>

                    <!-- Header -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Ellipse x:Name="IoTStatusDot"
                                 Grid.Column="0"
                                 Width="10"
                                 Height="10"
                                 Fill="{DynamicResource TextMutedBrush}"
                                 Margin="0,0,10,0"
                                 VerticalAlignment="Center" />

                        <TextBlock x:Name="SectionIoTTitle"
                                   Grid.Column="1"
                                   Text="AWS IoT Core"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />

                        <TextBlock x:Name="IoTStatusText"
                                   Grid.Column="2"
                                   Text="Not Configured"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <!-- Endpoint -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock x:Name="EndpointLabel"
                                   Text="Endpoint:"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,6" />
                        <TextBox x:Name="IoTEndpointTextBox"
                                 Text=""
                                 Style="{StaticResource GlassTextBox}"
                                 FontSize="13"
                                 VerticalContentAlignment="Center" />
                    </StackPanel>

                    <!-- Topic Prefix -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock x:Name="TopicPrefixLabel"
                                   Text="Topic Prefix:"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,6" />
                        <TextBox x:Name="IoTTopicTextBox"
                                 Text="factory/vision"
                                 Style="{StaticResource GlassTextBox}"
                                 FontSize="13"
                                 VerticalContentAlignment="Center" />
                    </StackPanel>

                    <!-- Action Buttons -->
                    <StackPanel Margin="0,0,0,14">
                        <Button x:Name="CloudAlertButton"
                                Content="Send Alert"
                                Style="{StaticResource GlassButton}"
                                Padding="14,8"
                                FontSize="13"
                                IsEnabled="False"
                                Margin="0,0,0,10" />
                        <Button x:Name="CloudPublishStatsButton"
                                Content="Publish Stats"
                                Style="{StaticResource GlassButton}"
                                Padding="14,8"
                                FontSize="13"
                                IsEnabled="False" />
                    </StackPanel>

                    <!-- Connection Status -->
                    <TextBlock x:Name="IoTConnectionStatusText"
                               Text=""
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" />

                </StackPanel>
            </Border>

            <!-- Thin vertical divider -->
            <Border Grid.Column="3"
                    Grid.Row="0"
                    Width="1"
                    Background="{DynamicResource GlassBorderBrush}"
                    Margin="0,12"
                    VerticalAlignment="Stretch" />

            <!-- ═══════════════════════════════════════════════════════════
                 RIGHT COLUMN — Lambda
                 ═══════════════════════════════════════════════════════════ -->
            <Border Grid.Column="4" Grid.Row="0" Style="{StaticResource GlassPanel}" Padding="20" Margin="12,0,0,0">
                <StackPanel>

                    <!-- Header -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Ellipse x:Name="LambdaStatusDot"
                                 Grid.Column="0"
                                 Width="10"
                                 Height="10"
                                 Fill="{DynamicResource TextMutedBrush}"
                                 Margin="0,0,10,0"
                                 VerticalAlignment="Center" />

                        <TextBlock x:Name="SectionLambdaTitle"
                                   Grid.Column="1"
                                   Text="AWS Lambda"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />

                        <TextBlock x:Name="LambdaStatusText"
                                   Grid.Column="2"
                                   Text="Not Configured"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <!-- Function -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock x:Name="FunctionLabel"
                                   Text="Function:"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,6" />
                        <TextBox x:Name="LambdaFuncTextBox"
                                 Text=""
                                 Style="{StaticResource GlassTextBox}"
                                 FontSize="13"
                                 VerticalContentAlignment="Center" />
                    </StackPanel>

                    <!-- Invoke Button -->
                    <Button x:Name="LambdaInvokeButton"
                            Content="Invoke"
                            Style="{StaticResource GlassButton}"
                            Padding="14,8"
                            FontSize="13"
                            IsEnabled="False"
                            Margin="0,0,0,14" />

                    <!-- Last Result -->
                    <StackPanel>
                        <TextBlock x:Name="LastResultLabel"
                                   Text="Last Result:"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,8" />
                        <Border Background="#14FFFFFF"
                                CornerRadius="{StaticResource CornerMd}"
                                Padding="14"
                                BorderBrush="{DynamicResource GlassBorderBrush}"
                                BorderThickness="1"
                                MaxHeight="260">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <TextBlock x:Name="LambdaResultText"
                                           Text=""
                                           FontSize="13"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════
                 BOTTOM ROW — Initialize (full width)
                 ═══════════════════════════════════════════════════════════ -->
            <Border Grid.Column="0"
                    Grid.ColumnSpan="5"
                    Grid.Row="1"
                    Style="{StaticResource GlassPanel}"
                    Padding="20"
                    Margin="0,12,0,0">
                <StackPanel HorizontalAlignment="Center">

                    <Button x:Name="CloudInitButton"
                            Content="Initialize All"
                            Style="{StaticResource AccentButton}"
                            Padding="24,12"
                            FontSize="15"
                            FontWeight="Bold"
                            Margin="0,0,0,12" />

                    <TextBlock x:Name="CloudOverallStatus"
                               Text="Services not initialized"
                               FontSize="14"
                               Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center" />

                </StackPanel>
            </Border>

        </Grid>
    </ScrollViewer>
</UserControl>
